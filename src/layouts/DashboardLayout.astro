---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'AgriFlow Dashboard', description = 'Gestion agricole simplifiée' } = Astro.props;

import Sidebar from '../components/dashboard/Sidebar.svelte';
import Header from '../components/dashboard/Header.svelte';
import MobileSidebar from '../components/dashboard/MobileSidebar.svelte';

// Récupérer la langue actuelle depuis l'URL ou la valeur par défaut
const currentLang = Astro.url.pathname.startsWith('/en/') ? 'en' : 'fr';
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Google Material Icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
    <!-- Emplacement pour ajouter d'autres éléments au head -->
    <slot name="head" />
    
    <!-- Injection des traductions côté client -->
    <!-- <ClientTranslations /> -->
  </head>
  <body class="h-full bg-gray-50 dark:bg-gray-900">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar pour Desktop -->
      <Sidebar client:load />
      
      <!-- Sidebar pour Mobile -->
      <MobileSidebar client:load />
      
      <!-- Contenu principal -->
      <div class="flex flex-col flex-1 overflow-hidden">
        <!-- Header / Barre de navigation -->
        <Header client:load />
        
        <!-- Contenu de la page -->
        <main class="flex-1 overflow-y-auto p-4 bg-gray-50 dark:bg-gray-900">
          <slot />
        </main>
      </div>
    </div>

    <script>
      // Initialisation du thème sombre/clair
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
            
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }

      window.localStorage.setItem('theme', theme || 'light');
      
      // Événements personnalisés pour la communication entre les composants
      document.addEventListener('DOMContentLoaded', () => {
        const headerElement = document.querySelector('header');
        const mobileSidebarElement = document.querySelector('div.mobile-sidebar');
        
        if (headerElement && mobileSidebarElement) {
          headerElement.addEventListener('toggleMenu', (event) => {
            const customEvent = event as CustomEvent;
            const isOpen = customEvent.detail;
            
            // Créer un événement personnalisé pour le composant MobileSidebar
            const toggleEvent = new CustomEvent('toggleMobileMenu', { 
              detail: { isOpen } 
            });
            
            mobileSidebarElement.dispatchEvent(toggleEvent);
          });
        }
      });
    </script>
  </body>
</html> 