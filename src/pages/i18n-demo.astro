---
import Layout from '../layouts/Layout.astro';
import I18nDemo from '../components/ui/I18nDemo.svelte';
import { t } from '../lib/utils/i18n';

// Obtenir la langue actuelle
const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split('/').filter(Boolean);
const currentLanguage = pathSegments[0] === 'en' ? 'en' : 'fr';
---

<Layout title={t('global.site_name') + ' - ' + t('global.language.switch')}>
	<main class="container mx-auto px-4 py-8">
		<h1 class="text-3xl font-bold mb-8 text-center text-primary dark:text-secondary">
			{t('global.language.switch')}
		</h1>

		<div class="max-w-2xl mx-auto">
			<section class="mb-8">
				<h2 class="text-2xl font-bold mb-4">{t('global.site_name')} - {t('global.site_description')}</h2>
				
				<div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md mb-6">
					<h3 class="text-xl font-semibold mb-4">Astro i18n</h3>
					<p class="mb-2">
						{t('hero.description')}
					</p>
					<p class="mb-2">
						{t('features.subtitle')}
					</p>
					<p class="mb-2">
						{t('footer.copyright', { year: new Date().getFullYear() })}
					</p>
				</div>
			</section>

			<section>
				<h2 class="text-2xl font-bold mb-4">Svelte i18n</h2>
				<I18nDemo client:load />
			</section>

			<section class="mt-8 bg-gray-100 dark:bg-gray-900 p-6 rounded-lg">
				<h2 class="text-2xl font-bold mb-4">Informations techniques</h2>
				<ul class="list-disc list-inside space-y-2">
					<li><strong>Langue actuelle :</strong> {currentLanguage}</li>
					<li><strong>Plugin i18n :</strong> astro-i18n</li>
					<li><strong>Langues supportées :</strong> Français, English</li>
				</ul>
			</section>

			<div class="mt-8 text-center">
				<a href="/" class="inline-block px-6 py-3 bg-primary text-white rounded-full hover:bg-primary-dark transition-colors">
					{t('navigation.home')}
				</a>
			</div>
		</div>
	</main>
</Layout> 