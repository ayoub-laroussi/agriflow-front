		<Hero />
		
		<!-- Section Fonctionnalités -->
		<Features />
		
		<!-- Section Bénéfices -->
		<Benefits />
		
		<!-- Section Démo -->
		<Demo />
		
		<!-- Section CTA -->
		<Cta />
		
		<!-- Ajouter le footer -->
		<Footer />
		
