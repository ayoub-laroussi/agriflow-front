---
import Layout from '../../layouts/Layout.astro';

// Récupération de la locale à partir de l'URL
const locale = Astro.currentLocale || 'en';
---

<Layout title="Test i18n">
	<main>
		<div class="container mx-auto px-4 py-12 text-center">
			<h1 class="text-3xl font-bold mb-4">Test Page in English</h1>
			<p>Current locale: {locale}</p>
			
			<div class="mt-8">
				<a href="/" class="px-4 py-2 bg-blue-600 text-white rounded">Retour à l'accueil (FR)</a>
			</div>
		</div>
	</main>
</Layout> 