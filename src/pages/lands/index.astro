---
import Layout from '../../layouts/Layout.astro';
import LandList from '../../components/ui/LandList.svelte';
import FloatingActionButton from '../../components/ui/FloatingActionButton.svelte';
---

<Layout title="Terrains | AgriFlow">
  <main class="container mx-auto py-8 px-4">
    <h1 class="text-3xl font-bold mb-6">Gestion des terrains</h1>
    
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Créez et gérez vos terrains agricoles pour une meilleure organisation de vos cultures.
    </p>
    
    <div class="bg-white dark:bg-gray-800 shadow-md rounded-lg p-6">
      <LandList client:load />
    </div>
    
    <FloatingActionButton 
      client:load
      icon="add"
      label="Ajouter un terrain"
      showLabel={true}
    />
  </main>
</Layout> 

