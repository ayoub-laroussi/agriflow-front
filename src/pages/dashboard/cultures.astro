---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Gestion des cultures | AgriFlow">
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
          Gestion des cultures
        </h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Planifiez et suivez vos cultures sur l'ensemble de vos terrains
        </p>
      </div>
      <div class="mt-4 md:mt-0">
        <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
          <span class="material-symbols-outlined mr-2">add</span>
          Ajouter une culture
        </button>
      </div>
    </div>

    <!-- Filtres et recherche -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="w-full md:w-64">
          <label for="search" class="sr-only">Rechercher</label>
          <div class="relative text-gray-400 focus-within:text-gray-600 dark:focus-within:text-gray-300">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="material-symbols-outlined">search</span>
            </div>
            <input
              id="search"
              class="block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md leading-5 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-green-500 focus:border-green-500 sm:text-sm"
              placeholder="Rechercher une culture..."
              type="search"
            >
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <select
            class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
          >
            <option>Toutes les saisons</option>
            <option>Printemps</option>
            <option>Été</option>
            <option>Automne</option>
            <option>Hiver</option>
          </select>
          <select
            class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
          >
            <option>Tous les états</option>
            <option>En préparation</option>
            <option>En croissance</option>
            <option>En récolte</option>
            <option>Terminée</option>
          </select>
        </div>
      </div>
    </div>
    
    <!-- Liste des cultures actives -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white flex items-center">
          <span class="material-symbols-outlined mr-2">eco</span>
          Cultures actives
        </h3>
      </div>
      <div class="overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-4">
          <!-- Carte Culture 1 -->
          <div class="bg-white dark:bg-gray-750 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden">
            <div class="h-40 bg-green-100 dark:bg-green-900 relative">
              <img 
                src="https://images.unsplash.com/photo-1591857177580-dc82b9ac4e1e" 
                alt="Tomates" 
                class="w-full h-full object-cover"
              />
              <div class="absolute top-2 right-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                  En croissance
                </span>
              </div>
            </div>
            <div class="p-4">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white">Tomates Roma</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Potager Sud - Planche 2</p>
                </div>
                <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                  <span class="material-symbols-outlined">more_vert</span>
                </button>
              </div>
              <div class="mt-4">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-500 dark:text-gray-400">Progression</span>
                  <span class="font-medium text-gray-700 dark:text-gray-300">45%</span>
                </div>
                <div class="mt-1 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full" style="width: 45%"></div>
                </div>
              </div>
              <div class="mt-4 flex justify-between text-sm">
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Plantation</span>
                  <p class="font-medium text-gray-900 dark:text-white">15/04/2023</p>
                </div>
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Récolte prévue</span>
                  <p class="font-medium text-gray-900 dark:text-white">25/07/2023</p>
                </div>
              </div>
              <div class="mt-4 flex justify-between">
                <a href="/dashboard/cultures/1" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
                  Voir les détails
                </a>
                <div class="flex space-x-2">
                  <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                    <span class="material-symbols-outlined">edit</span>
                  </button>
                  <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Carte Culture 2 -->
          <div class="bg-white dark:bg-gray-750 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden">
            <div class="h-40 bg-green-100 dark:bg-green-900 relative">
              <img 
                src="https://images.unsplash.com/photo-1595165305017-4b6b7c0b7b1d" 
                alt="Carottes" 
                class="w-full h-full object-cover"
              />
              <div class="absolute top-2 right-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                  Prêt à récolter
                </span>
              </div>
            </div>
            <div class="p-4">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white">Carottes Nantaises</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Potager Est - Planche 1</p>
                </div>
                <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                  <span class="material-symbols-outlined">more_vert</span>
                </button>
              </div>
              <div class="mt-4">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-500 dark:text-gray-400">Progression</span>
                  <span class="font-medium text-gray-700 dark:text-gray-300">95%</span>
                </div>
                <div class="mt-1 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full" style="width: 95%"></div>
                </div>
              </div>
              <div class="mt-4 flex justify-between text-sm">
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Plantation</span>
                  <p class="font-medium text-gray-900 dark:text-white">10/03/2023</p>
                </div>
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Récolte prévue</span>
                  <p class="font-medium text-gray-900 dark:text-white">15/06/2023</p>
                </div>
              </div>
              <div class="mt-4 flex justify-between">
                <a href="/dashboard/cultures/2" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
                  Voir les détails
                </a>
                <div class="flex space-x-2">
                  <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                    <span class="material-symbols-outlined">edit</span>
                  </button>
                  <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Carte Culture 3 -->
          <div class="bg-white dark:bg-gray-750 border border-gray-200 dark:border-gray-700 rounded-lg shadow-sm overflow-hidden">
            <div class="h-40 bg-green-100 dark:bg-green-900 relative">
              <img 
                src="https://images.unsplash.com/photo-1601493700631-2b16ec4b4716" 
                alt="Laitue" 
                class="w-full h-full object-cover"
              />
              <div class="absolute top-2 right-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">
                  En préparation
                </span>
              </div>
            </div>
            <div class="p-4">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white">Laitue Batavia</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Potager Nord - Planche 3</p>
                </div>
                <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                  <span class="material-symbols-outlined">more_vert</span>
                </button>
              </div>
              <div class="mt-4">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-500 dark:text-gray-400">Progression</span>
                  <span class="font-medium text-gray-700 dark:text-gray-300">15%</span>
                </div>
                <div class="mt-1 w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
                  <div class="bg-green-500 h-2 rounded-full" style="width: 15%"></div>
                </div>
              </div>
              <div class="mt-4 flex justify-between text-sm">
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Plantation</span>
                  <p class="font-medium text-gray-900 dark:text-white">05/06/2023</p>
                </div>
                <div>
                  <span class="text-gray-500 dark:text-gray-400">Récolte prévue</span>
                  <p class="font-medium text-gray-900 dark:text-white">20/07/2023</p>
                </div>
              </div>
              <div class="mt-4 flex justify-between">
                <a href="/dashboard/cultures/3" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
                  Voir les détails
                </a>
                <div class="flex space-x-2">
                  <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                    <span class="material-symbols-outlined">edit</span>
                  </button>
                  <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 text-center">
          <a href="#" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
            Voir toutes les cultures actives
          </a>
        </div>
      </div>
    </div>
    
    <!-- Cultures planifiées -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white flex items-center">
          <span class="material-symbols-outlined mr-2">event</span>
          Cultures planifiées
        </h3>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Nom
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Emplacement
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Date plantation
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Récolte prévue
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                Courgettes
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                Potager Sud - Planche 3
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                20/06/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                15/08/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300 text-right">
                <button class="text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300 mr-3">
                  <span class="material-symbols-outlined">edit</span>
                </button>
                <button class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                Aubergines
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                Serre - Rangée 1
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                25/06/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                10/09/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300 text-right">
                <button class="text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300 mr-3">
                  <span class="material-symbols-outlined">edit</span>
                </button>
                <button class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </td>
            </tr>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-white">
                Poivrons
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                Serre - Rangée 2
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                25/06/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
                05/09/2023
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300 text-right">
                <button class="text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300 mr-3">
                  <span class="material-symbols-outlined">edit</span>
                </button>
                <button class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-gray-200 dark:border-gray-700 text-center">
        <a href="#" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
          Voir toutes les cultures planifiées
        </a>
      </div>
    </div>
  </div>
</DashboardLayout> 