---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Calendrier agricole | AgriFlow">
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
          Calendrier agricole
        </h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Planifiez et visualisez toutes vos actions agricoles
        </p>
      </div>
      <div class="mt-4 md:mt-0 flex items-center space-x-2">
        <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
          <span class="material-symbols-outlined mr-2">add</span>
          Ajouter une action
        </button>
        <div class="relative">
          <button type="button" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            <span class="material-symbols-outlined mr-2">calendar_today</span>
            Juin 2023
            <span class="material-symbols-outlined ml-2">arrow_drop_down</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Navigation du calendrier -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 flex items-center justify-between">
        <div class="flex space-x-2">
          <button type="button" class="inline-flex items-center p-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            <span class="material-symbols-outlined">navigate_before</span>
          </button>
          <button type="button" class="inline-flex items-center p-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            <span class="material-symbols-outlined">navigate_next</span>
          </button>
          <button type="button" class="inline-flex items-center px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            Aujourd'hui
          </button>
        </div>
        <div class="flex space-x-2">
          <button type="button" class="inline-flex items-center px-3 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            Jour
          </button>
          <button type="button" class="inline-flex items-center px-3 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            Semaine
          </button>
          <button type="button" class="inline-flex items-center px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
            Mois
          </button>
        </div>
      </div>
    </div>

    <!-- Calendrier mensuel -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white">
          Juin 2023
        </h3>
      </div>
      <div class="overflow-hidden">
        <div class="grid grid-cols-7 gap-px border-b border-gray-200 dark:border-gray-700 bg-gray-200 dark:bg-gray-700">
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Lun
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Mar
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Mer
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Jeu
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Ven
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Sam
          </div>
          <div class="text-center py-2 font-semibold text-sm text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800">
            Dim
          </div>
        </div>
        
        <div class="grid grid-cols-7 gap-px bg-gray-200 dark:bg-gray-700">
          <!-- Jours du mois précédent (grisés) -->
          <div class="min-h-[120px] bg-gray-50 dark:bg-gray-750 p-2">
            <div class="text-sm text-gray-400 dark:text-gray-500">29</div>
          </div>
          <div class="min-h-[120px] bg-gray-50 dark:bg-gray-750 p-2">
            <div class="text-sm text-gray-400 dark:text-gray-500">30</div>
          </div>
          <div class="min-h-[120px] bg-gray-50 dark:bg-gray-750 p-2">
            <div class="text-sm text-gray-400 dark:text-gray-500">31</div>
          </div>
          
          <!-- Jours du mois actuel -->
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">1</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">2</div>
            <div class="mt-1">
              <div class="bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs p-1 rounded mb-1 truncate">
                Plantation carottes
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">3</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">4</div>
          </div>
          
          <!-- Deuxième semaine -->
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">5</div>
            <div class="mt-1">
              <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs p-1 rounded mb-1 truncate">
                Arrosage potager sud
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">6</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">7</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">8</div>
            <div class="mt-1">
              <div class="bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 text-xs p-1 rounded mb-1 truncate">
                Fertilisation verger
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">9</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">10</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">11</div>
          </div>
          
          <!-- Troisième semaine (avec date actuelle) -->
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">12</div>
            <div class="mt-1">
              <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs p-1 rounded mb-1 truncate">
                Arrosage potager sud
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-green-50 dark:bg-green-900 p-2 relative overflow-hidden">
            <div class="text-sm font-medium text-green-800 dark:text-green-200">13</div>
            <div class="absolute top-0 right-0 w-0 h-0 border-t-[25px] border-r-[25px] border-t-transparent border-r-green-500"></div>
            <div class="mt-1">
              <div class="bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 text-xs p-1 rounded mb-1 truncate">
                Taille des pommiers
              </div>
              <div class="bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 text-xs p-1 rounded mb-1 truncate">
                Réunion coopérative
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">14</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">15</div>
            <div class="mt-1">
              <div class="bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 text-xs p-1 rounded mb-1 truncate">
                Fertilisation naturelle
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">16</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">17</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">18</div>
          </div>
          
          <!-- Semaines restantes du mois -->
          <!-- Quatrième semaine -->
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">19</div>
            <div class="mt-1">
              <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs p-1 rounded mb-1 truncate">
                Arrosage potager sud
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">20</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">21</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">22</div>
            <div class="mt-1">
              <div class="bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs p-1 rounded mb-1 truncate">
                Plantation courgettes
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">23</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">24</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">25</div>
            <div class="mt-1">
              <div class="bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 text-xs p-1 rounded mb-1 truncate">
                Surveillance nuisibles
              </div>
            </div>
          </div>
          
          <!-- Cinquième semaine -->
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">26</div>
            <div class="mt-1">
              <div class="bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs p-1 rounded mb-1 truncate">
                Arrosage potager sud
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">27</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">28</div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">29</div>
            <div class="mt-1">
              <div class="bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs p-1 rounded mb-1 truncate">
                Plantation tomates
              </div>
            </div>
          </div>
          <div class="min-h-[120px] bg-white dark:bg-gray-800 p-2">
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300">30</div>
          </div>
          
          <!-- Jours du mois suivant (grisés) -->
          <div class="min-h-[120px] bg-gray-50 dark:bg-gray-750 p-2">
            <div class="text-sm text-gray-400 dark:text-gray-500">1</div>
          </div>
          <div class="min-h-[120px] bg-gray-50 dark:bg-gray-750 p-2">
            <div class="text-sm text-gray-400 dark:text-gray-500">2</div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Événements à venir -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white flex items-center">
          <span class="material-symbols-outlined mr-2">upcoming</span>
          Événements à venir
        </h3>
      </div>
      <div class="overflow-hidden">
        <ul class="divide-y divide-gray-200 dark:divide-gray-700">
          <li class="px-4 py-4 flex items-center hover:bg-gray-50 dark:hover:bg-gray-700">
            <div class="flex-shrink-0 h-12 w-12 rounded-md bg-green-100 dark:bg-green-900 flex items-center justify-center">
              <span class="material-symbols-outlined text-green-700 dark:text-green-300">eco</span>
            </div>
            <div class="ml-4 flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-900 dark:text-white">
                  Plantation des courgettes
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  22 juin 2023
                </p>
              </div>
              <div class="mt-1 flex items-center">
                <span class="material-symbols-outlined text-gray-400 text-xs mr-1">place</span>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  Potager Sud - Planche 3
                </p>
                <span class="ml-3 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-100">
                  Plantation
                </span>
              </div>
            </div>
          </li>
          <li class="px-4 py-4 flex items-center hover:bg-gray-50 dark:hover:bg-gray-700">
            <div class="flex-shrink-0 h-12 w-12 rounded-md bg-blue-100 dark:bg-blue-900 flex items-center justify-center">
              <span class="material-symbols-outlined text-blue-700 dark:text-blue-300">water_drop</span>
            </div>
            <div class="ml-4 flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-900 dark:text-white">
                  Arrosage du potager sud
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  26 juin 2023
                </p>
              </div>
              <div class="mt-1 flex items-center">
                <span class="material-symbols-outlined text-gray-400 text-xs mr-1">place</span>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  Potager Sud
                </p>
                <span class="ml-3 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-100">
                  Arrosage
                </span>
              </div>
            </div>
          </li>
          <li class="px-4 py-4 flex items-center hover:bg-gray-50 dark:hover:bg-gray-700">
            <div class="flex-shrink-0 h-12 w-12 rounded-md bg-green-100 dark:bg-green-900 flex items-center justify-center">
              <span class="material-symbols-outlined text-green-700 dark:text-green-300">eco</span>
            </div>
            <div class="ml-4 flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-gray-900 dark:text-white">
                  Plantation de tomates
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  29 juin 2023
                </p>
              </div>
              <div class="mt-1 flex items-center">
                <span class="material-symbols-outlined text-gray-400 text-xs mr-1">place</span>
                <p class="text-xs text-gray-500 dark:text-gray-400">
                  Potager Est - Planche 2
                </p>
                <span class="ml-3 px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-100">
                  Plantation
                </span>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</DashboardLayout> 