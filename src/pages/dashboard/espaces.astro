---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Espaces de culture | AgriFlow">
  <div class="container mx-auto">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
      <div>
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
          Espaces de culture
        </h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Gérez les différents espaces de culture dans vos terrains
        </p>
      </div>
      <div class="mt-4 md:mt-0">
        <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
          <span class="material-symbols-outlined mr-2">add</span>
          Ajouter un espace
        </button>
      </div>
    </div>

    <!-- Filtres et recherche -->
    <div class="bg-white dark:bg-gray-800 shadow overflow-hidden sm:rounded-lg mb-6">
      <div class="px-4 py-5 sm:px-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="w-full md:w-64">
          <label for="search" class="sr-only">Rechercher</label>
          <div class="relative text-gray-400 focus-within:text-gray-600 dark:focus-within:text-gray-300">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <span class="material-symbols-outlined">search</span>
            </div>
            <input
              id="search"
              class="block w-full pl-10 pr-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md leading-5 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-green-500 focus:border-green-500 sm:text-sm"
              placeholder="Rechercher un espace..."
              type="search"
            >
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <select
            class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
          >
            <option>Tous les terrains</option>
            <option>Terrain principal</option>
            <option>Serre</option>
            <option>Verger</option>
          </select>
          <select
            class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 focus:outline-none focus:ring-green-500 focus:border-green-500 sm:text-sm rounded-md bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
          >
            <option>Tous les types</option>
            <option>Planche</option>
            <option>Rangée</option>
            <option>Parcelle</option>
            <option>Pot</option>
          </select>
        </div>
      </div>
    </div>
    
    <!-- Vue en grille des espaces -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      <!-- Espace 1 -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="h-48 bg-green-100 dark:bg-green-900 relative">
          <img 
            src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449" 
            alt="Potager Sud - Planche 1" 
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 right-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
              Planche
            </span>
          </div>
        </div>
        <div class="p-4">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Potager Sud - Planche 1</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Terrain principal</p>
            </div>
            <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
              <span class="material-symbols-outlined">more_vert</span>
            </button>
          </div>
          <div class="mt-4">
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500 dark:text-gray-400">Dimensions</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">10m x 1.2m</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">Surface</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">12 m²</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">État</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                Cultivé
              </span>
            </div>
          </div>
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Cultures actuelles</h4>
            <div class="mt-2 flex flex-wrap gap-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Carottes
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Radis
              </span>
            </div>
          </div>
          <div class="mt-4 flex justify-between">
            <a href="/dashboard/espaces/1" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
              Voir les détails
            </a>
            <div class="flex space-x-2">
              <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <span class="material-symbols-outlined">edit</span>
              </button>
              <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Espace 2 -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="h-48 bg-green-100 dark:bg-green-900 relative">
          <img 
            src="https://images.unsplash.com/photo-1592150621744-aca64f48394a" 
            alt="Serre - Rangée 1" 
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 right-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
              Rangée
            </span>
          </div>
        </div>
        <div class="p-4">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Serre - Rangée 1</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Serre principale</p>
            </div>
            <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
              <span class="material-symbols-outlined">more_vert</span>
            </button>
          </div>
          <div class="mt-4">
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500 dark:text-gray-400">Dimensions</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">8m x 0.8m</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">Surface</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">6.4 m²</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">État</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                Cultivé
              </span>
            </div>
          </div>
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Cultures actuelles</h4>
            <div class="mt-2 flex flex-wrap gap-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Tomates
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Poivrons
              </span>
            </div>
          </div>
          <div class="mt-4 flex justify-between">
            <a href="/dashboard/espaces/2" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
              Voir les détails
            </a>
            <div class="flex space-x-2">
              <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <span class="material-symbols-outlined">edit</span>
              </button>
              <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Espace 3 -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="h-48 bg-green-100 dark:bg-green-900 relative">
          <img 
            src="https://images.unsplash.com/photo-1589923188651-268a9765e432" 
            alt="Potager Est - Planche 2" 
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 right-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
              Planche
            </span>
          </div>
        </div>
        <div class="p-4">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Potager Est - Planche 2</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Terrain principal</p>
            </div>
            <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
              <span class="material-symbols-outlined">more_vert</span>
            </button>
          </div>
          <div class="mt-4">
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500 dark:text-gray-400">Dimensions</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">8m x 1.2m</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">Surface</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">9.6 m²</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">État</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                En préparation
              </span>
            </div>
          </div>
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Cultures planifiées</h4>
            <div class="mt-2 flex flex-wrap gap-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-50 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-100">
                Laitues
              </span>
            </div>
          </div>
          <div class="mt-4 flex justify-between">
            <a href="/dashboard/espaces/3" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
              Voir les détails
            </a>
            <div class="flex space-x-2">
              <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <span class="material-symbols-outlined">edit</span>
              </button>
              <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Espace 4 -->
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="h-48 bg-green-100 dark:bg-green-900 relative">
          <img 
            src="https://images.unsplash.com/photo-1599577180758-6d08e5be7f37" 
            alt="Verger - Parcelle 1" 
            class="w-full h-full object-cover"
          />
          <div class="absolute top-2 right-2">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200">
              Parcelle
            </span>
          </div>
        </div>
        <div class="p-4">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white">Verger - Parcelle 1</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">Verger</p>
            </div>
            <button class="text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
              <span class="material-symbols-outlined">more_vert</span>
            </button>
          </div>
          <div class="mt-4">
            <div class="flex justify-between items-center text-sm">
              <span class="text-gray-500 dark:text-gray-400">Dimensions</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">15m x 20m</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">Surface</span>
              <span class="font-medium text-gray-700 dark:text-gray-300">300 m²</span>
            </div>
            <div class="flex justify-between items-center text-sm mt-2">
              <span class="text-gray-500 dark:text-gray-400">État</span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                Cultivé
              </span>
            </div>
          </div>
          <div class="mt-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300">Cultures actuelles</h4>
            <div class="mt-2 flex flex-wrap gap-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Pommiers
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900 dark:text-green-100">
                Poiriers
              </span>
            </div>
          </div>
          <div class="mt-4 flex justify-between">
            <a href="/dashboard/espaces/4" class="text-sm font-medium text-green-600 hover:text-green-500 dark:text-green-400 dark:hover:text-green-300">
              Voir les détails
            </a>
            <div class="flex space-x-2">
              <button class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                <span class="material-symbols-outlined">edit</span>
              </button>
              <button class="text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                <span class="material-symbols-outlined">delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Pagination -->
    <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-4 py-3 sm:px-6 rounded-lg shadow">
      <div class="flex-1 flex justify-between sm:hidden">
        <a href="#" class="relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700">
          Précédent
        </a>
        <a href="#" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700">
          Suivant
        </a>
      </div>
      <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-gray-700 dark:text-gray-300">
            Affichage de <span class="font-medium">1</span> à <span class="font-medium">4</span> sur <span class="font-medium">10</span> espaces
          </p>
        </div>
        <div>
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
              <span class="sr-only">Précédent</span>
              <span class="material-symbols-outlined">chevron_left</span>
            </a>
            <a href="#" aria-current="page" class="z-10 bg-green-50 dark:bg-green-900 border-green-500 dark:border-green-500 text-green-600 dark:text-green-200 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
              1
            </a>
            <a href="#" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
              2
            </a>
            <a href="#" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-4 py-2 border text-sm font-medium">
              3
            </a>
            <a href="#" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
              <span class="sr-only">Suivant</span>
              <span class="material-symbols-outlined">chevron_right</span>
            </a>
          </nav>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout> 