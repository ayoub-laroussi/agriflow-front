---
import Layout from '../../layouts/Layout.astro';
import AuthCard from '../../components/ui/AuthCard.svelte';
import LoginForm from '../../components/auth/LoginForm.svelte';
import AuthCheck from '../../components/auth/AuthCheck.svelte';
import { t } from '../../lib/utils/i18n';

const title = t('auth.login.title', 'Connexion | AgriFlow');
const description = t('auth.login.meta.description', 'Connectez-vous à votre compte AgriFlow');
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex items-center justify-center px-4 py-12 bg-gray-50 dark:bg-gray-900">
    <div class="w-full max-w-md">
      <!-- Vérification d'authentification (rediriger si déjà connecté) -->
      <AuthCheck client:only="svelte" mode="guest" />
      
      <div class="text-center mb-8">
        <a href="/" class="inline-block">
          <h1 class="text-3xl font-bold text-primary">AgriFlow</h1>
        </a>
      </div>
      
      <AuthCard 
        title={t('auth.login.cardTitle', 'Connexion')} 
        subtitle={t('auth.login.cardSubtitle', 'Connectez-vous pour accéder à votre compte')}
      >
        <LoginForm client:load />
      </AuthCard>
      
      <div class="mt-8 text-center text-sm text-gray-600 dark:text-gray-400">
        <p>&copy; {new Date().getFullYear()} AgriFlow. Tous droits réservés.</p>
      </div>
    </div>
  </main>
</Layout> 