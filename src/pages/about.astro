---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Trans from '../components/Trans.astro';

const { t } = Astro.locals;
---

<Layout title={`${t('global.site_name')} - ${t('about.title')}`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">{t('about.title')}</h1>
    
    <div class="prose max-w-none">
      <p class="mb-4">{t('about.introduction')}</p>
      
      <h2 class="text-2xl font-bold mt-8 mb-4">{t('about.mission.title')}</h2>
      <p class="mb-4">{t('about.mission.description')}</p>
      
      <h2 class="text-2xl font-bold mt-8 mb-4">{t('about.vision.title')}</h2>
      <p class="mb-4">{t('about.vision.description')}</p>
    </div>
    
    <div class="mt-8">
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'fr', '')} class="text-blue-600 hover:underline">
        {t('navigation.back_to_home')}
      </a>
    </div>
    
    <div class="language-selector mt-8">
      <a href={getRelativeLocaleUrl('fr', 'about')} class="mr-4">Français</a>
      <a href={getRelativeLocaleUrl('en', 'about')}>English</a>
    </div>
  </main>
</Layout> 