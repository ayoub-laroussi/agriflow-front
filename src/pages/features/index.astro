---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Trans from '../../components/Trans.astro';

const { t } = Astro.locals;

// Simulons une liste de fonctionnalités
const featureKeys = ['crop_management', 'inventory', 'reporting', 'planning'];
---

<Layout title={`${t('global.site_name')} - ${t('features.title')}`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">{t('features.title')}</h1>
    
    <p class="mb-8">{t('features.introduction')}</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featureKeys.map(key => (
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h2 class="text-xl font-semibold mb-3">
            {t(`features.${key}.title`)}
          </h2>
          <p class="text-gray-700 mb-4">
            {t(`features.${key}.description`)}
          </p>
          <a 
            href={getRelativeLocaleUrl(Astro.currentLocale || 'fr', `features/${key}`)}
            class="text-blue-600 hover:underline"
          >
            {t('features.learn_more')}
          </a>
        </div>
      ))}
    </div>
    
    <div class="mt-12">
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'fr', '')} class="text-blue-600 hover:underline">
        {t('navigation.back_to_home')}
      </a>
    </div>
    
    <div class="language-selector mt-8">
      <a href={getRelativeLocaleUrl('fr', 'features')} class="mr-4">Français</a>
      <a href={getRelativeLocaleUrl('en', 'features')}>English</a>
    </div>
  </main>
</Layout> 