---
/**
 * Page de démonstration de l'internationalisation sans duplication
 * 
 * Cette page utilise le middleware i18n pour accéder aux traductions
 * et afficher le contenu dans la langue appropriée, sans avoir besoin
 * de dupliquer les pages dans différents dossiers linguistiques.
 */

import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

// Récupérer la langue actuelle
const currentLocale = Astro.url.pathname.split('/')[1] === 'en' ? 'en' : 'fr';

// Obtenir la fonction de traduction du middleware
const { t } = Astro.locals;

// Forcer le chargement des traductions spécifiques à cette page
const pageTitle = t('global.site_name');
const featureTitle = t('features.title');
const featureIntro = t('features.introduction');
const learnMore = t('features.learn_more');
const backToHome = t('navigation.back_to_home');
const languageSwitch = t('global.language.switch');

// Liste des fonctionnalités
const features = [
  'landManagement',
  'cropTracking',
  'agriculturalActions', 
  'calendar'
];
---

<Layout title={`${pageTitle} - ${featureTitle}`}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">{featureTitle}</h1>
    
    <p class="mb-8">{featureIntro}</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {features.map(key => (
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md">
          <h2 class="text-xl font-semibold mb-3">
            {t(`features.list.${key}.title`)}
          </h2>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            {t(`features.list.${key}.description`)}
          </p>
          <a 
            href={getRelativeLocaleUrl(currentLocale, `features/${key}`)}
            class="text-blue-600 hover:underline"
          >
            {learnMore}
          </a>
        </div>
      ))}
    </div>
    
    <div class="mt-12">
      <a href={getRelativeLocaleUrl(currentLocale, '')} class="text-blue-600 hover:underline">
        {backToHome}
      </a>
    </div>
    
    <!-- Sélecteur de langue -->
    <div class="language-selector mt-8">
      <p class="mb-2">{languageSwitch}:</p>
      <a href="/demo-i18n" class={`mr-4 ${currentLocale === 'fr' ? 'font-bold' : ''}`}>
        Français
      </a>
      <a href="/en/demo-i18n" class={currentLocale === 'en' ? 'font-bold' : ''}>
        English
      </a>
    </div>
  </main>
</Layout> 