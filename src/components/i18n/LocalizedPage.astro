---
/**
 * Composant LocalizedPage
 * 
 * Ce composant permet d'éviter de dupliquer les pages pour chaque langue
 * en utilisant le middleware i18n et les fichiers de traduction.
 */

import Layout from '../../layouts/Layout.astro';

interface Props {
  title: string;
  pageKey: string;
}

// Récupérer les props
const { title, pageKey } = Astro.props;

// Récupérer les traductions
const { t } = Astro.locals;

// Récupérer la langue courante
const currentLocale = Astro.url.pathname.split('/')[1] === 'en' ? 'en' : 'fr';

// Créer une fonction helper pour les traductions de la page
const i18n = (key: string) => {
  return t(`${pageKey}.${key}`);
};

// Exposer les variables au HTML
const pageData = {
  currentLocale,
  i18n,
  t
};
---

<Layout title={t(title)}>
  <slot {pageData} />
</Layout> 