---
import Translate from './Translate.svelte';

interface Props {
    icon: string;
    title: string;
    description: string;
    link?: string;
    index?: number;
}

const { icon, title, description, link, index } = Astro.props;

// Fonction pour vérifier si l'icône est un emoji ou un chemin vers un SVG
function isEmoji(str: string): boolean {
    return /\p{Emoji}/u.test(str);
}

// Construire le titre avec le préfixe d'index si nécessaire
const displayTitle = index ? `0${index}. ${title}` : title;

// Créer le wrapper approprié en fonction de la présence d'un lien
const Wrapper = link ? 'a' : 'div';
const wrapperProps = link ? { href: link } : {};
---

<Wrapper 
  {...wrapperProps}
  class={`bg-light dark:bg-gray-800 border dark:border-gray-700 rounded-lg shadow-md p-8 transition-all duration-300 hover:transform hover:-translate-y-2 hover:shadow-lg block ${link ? 'hover:text-primary cursor-pointer' : ''}`}
>
    <div class="text-4xl mb-4">
        {isEmoji(icon) ? 
            <span class="inline-block w-12 h-12 bg-primary/10 dark:bg-primary/20 rounded-full flex items-center justify-center">{icon}</span> : 
            <img src={icon} alt="Feature icon" class="w-12 h-12" />
        }
    </div>
    <h3 class="text-primary dark:text-secondary text-xl font-semibold mb-4">
        {displayTitle}
    </h3>
    <p class="text-text-light dark:text-gray-300">
        {description}
    </p>
    
    {link && (
      <div class="mt-4 text-sm font-medium text-primary dark:text-secondary flex items-center">
        <span class="mr-2">En savoir plus</span>
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="16" height="16" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2" 
          stroke-linecap="round" 
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>
    )}
</Wrapper> 