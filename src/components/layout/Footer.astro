---
import { t } from '../../lib/utils/i18n';
const currentYear = new Date().getFullYear();
---

<footer class="bg-text dark:bg-background border-t dark:border-gray-800 text-white dark:text-light pt-16 pb-8">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
            <div class="col-span-1 md:col-span-2 lg:col-span-1">
                <h3 class="text-white dark:text-secondary text-xl font-bold mb-6">{t('global.site_name')}</h3>
                <p class="text-white/80 dark:text-light/95 mb-6">{t('global.site_description')}</p>
                <div class="flex gap-4">
                    <a href="#" aria-label="Facebook" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary dark:hover:bg-secondary transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96C15.9 21.59 18.03 20.4 19.6 18.57C21.16 16.74 22.04 14.42 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/>
                        </svg>
                    </a>
                    <a href="#" aria-label="Twitter" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary dark:hover:bg-secondary transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21-.36.1-.74.15-1.13.15-.27 0-.54-.03-.8-.08.54 1.69 2.11 2.95 4 2.98-1.46 1.16-3.31 1.84-5.33 1.84-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z"/>
                        </svg>
                    </a>
                    <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary dark:hover:bg-secondary transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </a>
                    <a href="#" aria-label="LinkedIn" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-primary dark:hover:bg-secondary transition-all">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                        </svg>
                    </a>
                </div>
            </div>
            <div>
                <h4 class="text-white dark:text-secondary text-lg font-medium mb-6">{t('navigation.features')}</h4>
                <ul class="space-y-4">
                    <li><a href="#fonctionnalites" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('features.list.landManagement.title')}</a></li>
                    <li><a href="#fonctionnalites" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('features.list.cropTracking.title')}</a></li>
                    <li><a href="#fonctionnalites" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('features.list.agriculturalActions.title')}</a></li>
                    <li><a href="#fonctionnalites" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('features.list.calendar.title')}</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white dark:text-secondary text-lg font-medium mb-6">{t('footer.about.title')}</h4>
                <ul class="space-y-4">
                    <li><a href="#" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('footer.about.company')}</a></li>
                    <li><a href="/privacy" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('footer.about.privacy')}</a></li>
                    <li><a href="/terms" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('footer.about.terms')}</a></li>
                    <li><a href="/mentions" class="text-white/80 dark:text-light/95 hover:text-white dark:hover:text-white transition-colors">{t('footer.about.legal')}</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white dark:text-secondary text-lg font-medium mb-6">{t('footer.contact.title')}</h4>
                <div class="flex items-start mb-4">
                    <div class="mr-4 mt-1 text-primary dark:text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <p class="text-white/80 dark:text-light/95">{t('footer.contact.email')}</p>
                </div>
                <div class="flex items-start mb-4">
                    <div class="mr-4 mt-1 text-primary dark:text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                    </div>
                    <p class="text-white/80 dark:text-light/95">{t('footer.contact.phone')}</p>
                </div>
                <div class="flex items-start">
                    <div class="mr-4 mt-1 text-primary dark:text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                    </div>
                    <p class="text-white/80 dark:text-light/95">{t('footer.contact.address')}</p>
                </div>
            </div>
        </div>
        <div class="pt-8 border-t border-white/10 dark:border-gray-700 text-center text-white/60 dark:text-light/80">
            <p>{t('footer.copyright', { year: currentYear })}</p>
        </div>
    </div>
</footer> 