---
const { t } = Astro.locals;
---

<section id="contact" class="py-20 bg-primary text-white">
    <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center gap-8">
                <div class="md:w-1/2">
                    <h2 class="text-3xl md:text-4xl font-bold mb-4">
                        {t('cta.title')}
                    </h2>
                    <p class="text-xl opacity-90 mb-8">
                        {t('cta.description')}
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="/auth/register" class="inline-block py-3 px-8 rounded-full bg-white text-primary font-semibold transition-colors hover:bg-light">
                            {t('cta.button_primary')}
                        </a>
                        <a href="#demo" class="inline-block py-3 px-8 rounded-full border border-white text-white font-semibold hover:bg-white hover:text-primary transition-all">
                            {t('cta.button_secondary')}
                        </a>
                    </div>
                </div>
                <div class="md:w-1/3">
                    <div class="bg-white text-primary p-6 rounded-xl">
                        <h3 class="text-xl font-bold mb-4">Des questions ?</h3>
                        <form>
                            <div class="mb-4">
                                <input type="text" placeholder="Votre nom" class="w-full p-3 rounded border border-gray-200" />
                            </div>
                            <div class="mb-4">
                                <input type="email" placeholder="Votre email" class="w-full p-3 rounded border border-gray-200" />
                            </div>
                            <div class="mb-4">
                                <select class="w-full p-3 rounded border border-gray-200">
                                    <option value="" disabled selected>Type d'exploitation</option>
                                    <option value="riziere">Rizière</option>
                                    <option value="champ">Champ</option>
                                    <option value="verger">Verger</option>
                                    <option value="potager">Potager</option>
                                </select>
                            </div>
                            <div class="mb-4">
                                <textarea placeholder="Votre message" class="w-full p-3 rounded border border-gray-200 min-h-[100px]"></textarea>
                            </div>
                            <button type="submit" class="w-full py-3 px-8 rounded-full bg-primary text-white font-semibold hover:bg-primary-dark transition-colors">
                                Envoyer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section> 