---
const { t } = Astro.locals;

// Définir les avantages
const advantages = [
  {
    icon: "⏱️",
    title: t('demo.advantages.time_saving.title'),
    description: t('demo.advantages.time_saving.description')
  },
  {
    icon: "🔍",
    title: t('demo.advantages.decision.title'),
    description: t('demo.advantages.decision.description')
  },
  {
    icon: "📱",
    title: t('demo.advantages.adaptability.title'),
    description: t('demo.advantages.adaptability.description')
  }
];
---

<section id="demo" class="py-20 bg-white">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row items-center gap-12">
            <div class="md:w-1/2">
                <h2 class="text-3xl md:text-4xl font-bold mb-6">{t('demo.title')}</h2>
                <p class="text-text-light text-lg mb-8">
                    {t('demo.description')}
                </p>
                <a href="#contact" class="inline-block bg-primary text-white px-8 py-3 rounded-full font-semibold hover:bg-primary-dark transition-all">
                    {t('demo.cta')}
                </a>
            </div>
            <div class="md:w-1/2">
                <div class="relative rounded-xl overflow-hidden shadow-lg">
                    <img src="/images/home/riziere.jpg" alt="Démonstration AgriFlow" class="w-full h-[350px] object-cover" />
                    <div class="absolute inset-0 bg-black bg-opacity-30 flex items-center justify-center">
                        <button class="w-16 h-16 bg-white rounded-full flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-16 text-center">
            <h3 class="text-2xl font-bold mb-6">{t('demo.advantages.title')}</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
                {advantages.map(item => (
                    <div class="p-6 bg-light rounded-xl">
                        <div class="text-4xl mb-4">{item.icon}</div>
                        <h4 class="text-xl font-bold mb-3">{item.title}</h4>
                        <p class="text-text-light">{item.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section> 