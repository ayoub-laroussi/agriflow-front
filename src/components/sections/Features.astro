---
import FeatureCard from '../ui/FeatureCard.astro';
import { t } from '../../lib/utils/i18n';

// Les icônes sont conservées car elles sont identiques dans toutes les langues
const featureData = [
    {
        icon: "🏞️",
        key: "landManagement"
    },
    {
        icon: "🌱",
        key: "cropTracking"
    },
    {
        icon: "📝",
        key: "agriculturalActions"
    },
    {
        icon: "📅",
        key: "calendar"
    },
    {
        icon: "🔍",
        key: "observations"
    },
    {
        icon: "👥",
        key: "collaboration"
    }
];
---

<section id="fonctionnalites" class="py-20 bg-white dark:bg-background">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between mb-16">
            <div class="md:w-1/2 mb-8 md:mb-0">
                <h2 class="text-3xl md:text-4xl font-bold mb-4 text-text dark:text-light">{t('features.title')}</h2>
            </div>
            <div class="md:w-1/3">
                <p class="text-text-light dark:text-text-light text-lg">
                    {t('features.subtitle')}
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {featureData.slice(0, 3).map((feature, index) => (
                <div class="relative">
                    <FeatureCard 
                        icon={feature.icon} 
                        title={`0${index + 1}. ${t(`features.list.${feature.key}.title`)}`} 
                        description={t(`features.list.${feature.key}.description`)} 
                    />
                </div>
            ))}
        </div>

        <div class="mt-20 relative">
            <div class="w-full rounded-xl overflow-hidden">
                <img src="/images/home/riziere2.jpg" alt="Rizières" class="w-full h-[400px] object-cover" />
            </div>
            
            <div class="bg-white dark:bg-background rounded-xl p-8 shadow-lg border dark:border-gray-700 max-w-xl mx-auto md:absolute md:bottom-12 md:right-12">
                <h3 class="text-2xl font-bold mb-4 text-primary dark:text-secondary">{t('features.traceability.title')}</h3>
                <p class="text-text-light dark:text-light/90 mb-4">
                    {t('features.traceability.description')}
                </p>
                <div class="flex justify-end">
                    <span class="text-sm text-text-light dark:text-secondary/90">{t('features.traceability.caption')}</span>
                </div>
            </div>
        </div>

        <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
            {featureData.slice(3, 6).map((feature, index) => (
                <div class="relative">
                    <FeatureCard 
                        icon={feature.icon} 
                        title={`0${index + 4}. ${t(`features.list.${feature.key}.title`)}`} 
                        description={t(`features.list.${feature.key}.description`)} 
                    />
                </div>
            ))}
        </div>
    </div>
</section> 