---
import FeatureCard from '../ui/FeatureCard.astro';
const { t } = Astro.locals;

// Définition des fonctionnalités
const features = [
  {
    icon: "🌱",
    title: t('features.crop_management.title'),
    description: t('features.crop_management.description'),
    link: "/features/crop_management"
  },
  {
    icon: "📊",
    title: t('features.inventory.title'),
    description: t('features.inventory.description'),
    link: "/features/inventory"
  },
  {
    icon: "📝",
    title: t('features.reporting.title'),
    description: t('features.reporting.description'),
    link: "/features/reporting"
  },
  {
    icon: "🗓️",
    title: t('features.planning.title'),
    description: t('features.planning.description'),
    link: "/features/planning"
  }
];
---

<section class="py-20 bg-light dark:bg-background-alt">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center justify-center text-center mb-16">
      <span class="bg-primary/10 text-primary dark:bg-secondary/20 dark:text-secondary text-sm font-semibold px-4 py-1 rounded-full mb-4">
        {t('features.subtitle')}
      </span>
      
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-text dark:text-light">
        {t('features.title')}
      </h2>
      
      <p class="text-text-light max-w-xl">
        {t('features.introduction')}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          description={feature.description}
          link={feature.link}
        />
      ))}
    </div>
    
    <div class="mt-20 text-center">
      <h3 class="text-2xl font-bold mb-4 text-primary dark:text-secondary">
        {t('features.subtitle_advanced')}
      </h3>
      
      <p class="text-text-light max-w-2xl mx-auto mb-10">
        {t('features.description_advanced')}
      </p>
      
      <a
        href="/features"
        class="inline-flex items-center gap-2 text-primary dark:text-secondary hover:text-primary-dark dark:hover:text-primary transition-all font-semibold"
      >
        {t('features.learn_more')}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section> 