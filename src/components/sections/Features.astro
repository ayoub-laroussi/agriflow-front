---
import FeatureCard from '../ui/FeatureCard.astro';

// Définition des fonctionnalités
const features = [
  {
    icon: "🌱",
    title: "Gestion des cultures",
    description: "Suivez l'évolution de vos cultures de la plantation à la récolte avec des outils adaptés à vos besoins.",
    link: "/features/crop_management"
  },
  {
    icon: "📊",
    title: "Inventaire",
    description: "Gérez efficacement vos stocks de semences, d'engrais et d'autres ressources agricoles.",
    link: "/features/inventory"
  },
  {
    icon: "📝",
    title: "Rapports",
    description: "Générez des rapports détaillés sur vos activités agricoles pour une meilleure prise de décision.",
    link: "/features/reporting"
  },
  {
    icon: "🗓️",
    title: "Planification",
    description: "Planifiez vos activités agricoles à l'avance pour optimiser votre production et vos ressources.",
    link: "/features/planning"
  }
];
---

<section class="py-20 bg-light dark:bg-background-alt">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center justify-center text-center mb-16">
      <span class="bg-primary/10 text-primary dark:bg-secondary/20 dark:text-secondary text-sm font-semibold px-4 py-1 rounded-full mb-4">
        Fonctionnalités principales
      </span>
      
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-text dark:text-light">
        Des outils puissants pour votre exploitation
      </h2>
      
      <p class="text-text-light max-w-xl">
        Découvrez comment AgriFlow peut transformer votre gestion agricole avec des fonctionnalités innovantes et intuitives.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          description={feature.description}
          link={feature.link}
        />
      ))}
    </div>
    
    <div class="mt-20 text-center">
      <h3 class="text-2xl font-bold mb-4 text-primary dark:text-secondary">
        Fonctionnalités avancées
      </h3>
      
      <p class="text-text-light max-w-2xl mx-auto mb-10">
        Explorez nos fonctionnalités avancées conçues pour les agriculteurs professionnels qui souhaitent optimiser chaque aspect de leur exploitation.
      </p>
      
      <a
        href="/features"
        class="inline-flex items-center gap-2 text-primary dark:text-secondary hover:text-primary-dark dark:hover:text-primary transition-all font-semibold"
      >
        En savoir plus
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section> 